# 数据库
MYSQL_URL=jdbc:mysql://localhost:3306/inspiration_forge?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=app_user
MYSQL_PASSWORD=change-me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=change-me

# 用户密码摘要盐值：首次部署后必须保持不变，否则已有用户将无法登录
USER_PASSWORD_SALT=change-me-to-a-stable-random-value

# AI 模型
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
CODE_MODEL_NAME=deepseek-chat

# 腾讯云 COS（不使用对象存储时可留空）
TENCENT_COS_HOST=
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=
TENCENT_COS_BUCKET=

# 可选能力
PEXELS_API_KEY=
RAG_EMBEDDING_ENABLED=false
RAG_EMBEDDING_API_KEY=

# 作品访问域名（有域名填 https://你的域名/dist，否则填 http://你的服务器IP/dist）
DEPLOY_HOST=http://127.0.0.1/dist
